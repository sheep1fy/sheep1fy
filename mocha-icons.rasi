* {
    /* Catppuccin Mocha - Dark Mode Grey Theme */
    
    /* Primary backgrounds - deep dark grey */
    bg0:    rgba(20, 20, 25, 0.95);       /* Main window - very dark grey, nearly opaque */
    bg1:    rgba(30, 30, 35, 0.92);       /* Secondary surfaces - dark grey */
    bg2:    rgba(40, 40, 45, 0.90);       /* Tertiary surfaces - dark grey */
    bg3:    rgba(60, 60, 70, 0.95);       /* Accent/Selected - darker accent grey */
    bg-glass: rgba(25, 25, 30, 0.40);     /* Glass overlay - very transparent dark grey */
    
    /* Text colors - minimal light tones, mostly dark */
    fg0:    #a0a0a5;                      /* Primary text - dim grey */
    fg1:    #f0f0f0;                      /* Highlight text - white */
    fg2:    #808085;                      /* Secondary text - darker grey */
    fg3:    #505055;                      /* Tertiary text - very dark grey */

    /* Border styling - very dark subtle borders */
    border-light: rgba(160, 160, 165, 0.15);
    border-accent: rgba(100, 100, 115, 0.50);
    border-dark: rgba(15, 15, 20, 0.60);
}

* {
    font:   "Inter 13";

    background-color:   transparent;
    text-color:         @fg0;

    margin:     0px;
    padding:    0px;
    spacing:    0px;
}

window {
    location:       north;
    y-offset:       calc(50% - 180px);
    width:          680;
    border-radius:  28px;
    border:         2px;
    border-color:   @border-accent;

    background-color:   @bg0;
    
    /* Subtle shadow effect for depth */
    shadow:         "0 8px 32px rgba(0, 0, 0, 0.70)";
}

mainbox {
    padding:    20px;
    spacing:    12px;
    background-color: transparent;
}

inputbar {
    background-color:   @bg1;
    border-color:       @border-accent;

    border:         2px;
    border-radius:  24px;

    padding:    14px 24px;
    spacing:    12px;
    children:   [ prompt, entry ];
}

prompt {
    text-color: @fg1;
    font: "Inter 13";
    width: 2em;
}

entry {
    placeholder:        "Search applications...";
    placeholder-color:  @fg3;
    font: "Inter 13";
    text-color: @fg0;
}

message {
    margin:             12px 0 0;
    border-radius:      20px;
    border:             2px;
    border-color:       @border-light;
    background-color:   @bg2;
}

textbox {
    padding:    14px 24px;
    text-color: @fg0;
}

listview {
    background-color:   transparent;

    margin:             8px 0 0;
    lines:              6;
    columns:            1;

    fixed-height:       false;
    spacing:            4px;
}

element {
    padding:        10px 16px;
    spacing:        12px;
    border-radius:  18px;
    border:         2px;
    border-color:   transparent;

    background-color: @bg2;
    text-color: @fg1;
}

element normal active {
    text-color: @fg1;
    background-color: @bg2;
    border-color: @border-light;
}

element alternate active {
    text-color: @fg1;
    background-color: @bg2;
    border-color: @border-light;
}

element selected normal {
    background-color:   @bg3;
    border-color:       @border-accent;
    text-color:         @fg1;
}

element selected active {
    background-color:   @bg3;
    border-color:       @border-accent;
    text-color:         @fg1;
}

element-icon {
    size:           1.2em;
    vertical-align: 0.5;
}

element-text {
    text-color: inherit;
    vertical-align: 0.5;
}

element selected element-text {
    text-color: @fg1;
    font: "Inter 13";
}

scrollbar {
    width:        6px;
    border:       0;
    handle-color: @border-accent;
    handle-width: 6px;
    padding:      4px;
    margin:       0 4px 0 0;
    background-color: @bg-glass;
    border-radius: 3px;
}
