* {
    /* Catppuccin Mocha - Grey Blur & Opaque Theme */
    
    /* Primary backgrounds - grey with varying opacity */
    bg0:    rgba(45, 45, 50, 0.92);       /* Main window - dark grey, solid */
    bg1:    rgba(60, 60, 65, 0.88);       /* Secondary surfaces - grey */
    bg2:    rgba(75, 75, 80, 0.85);       /* Tertiary surfaces - medium grey */
    bg3:    rgba(100, 100, 105, 0.95);    /* Accent/Selected - lighter grey, opaque */
    bg-glass: rgba(50, 50, 55, 0.35);     /* Glass overlay - very transparent grey */
    
    /* Text colors - high contrast on grey */
    fg0:    #e0e0e0;                      /* Primary text - light grey */
    fg1:    #f0f0f0;                      /* Highlight text - off-white */
    fg2:    #c0c0c0;                      /* Secondary text - medium grey */
    fg3:    #808080;                      /* Tertiary text - dark grey */

    /* Border styling - subtle grey tones */
    border-light: rgba(224, 224, 224, 0.20);
    border-accent: rgba(150, 150, 160, 0.60);
    border-dark: rgba(40, 40, 45, 0.50);
}

* {
    font:   "Inter 13";

    background-color:   transparent;
    text-color:         @fg0;

    margin:     0px;
    padding:    0px;
    spacing:    0px;
}

window {
    location:       north;
    y-offset:       calc(50% - 180px);
    width:          680;
    border-radius:  28px;
    border:         2px;
    border-color:   @border-accent;

    background-color:   @bg0;
    
    /* Backdrop blur effect */
    backdrop-filter: blur(10px);
    
    /* Subtle shadow effect for depth */
    shadow:         "0 8px 32px rgba(0, 0, 0, 0.50)";
}

mainbox {
    padding:    20px;
    spacing:    12px;
    background-color: transparent;
}

inputbar {
    background-color:   @bg1;
    border-color:       @border-accent;

    border:         2px;
    border-radius:  24px;

    padding:    14px 24px;
    spacing:    12px;
    children:   [ prompt, entry ];
}

prompt {
    text-color: @fg1;
    font: "Inter 13";
    width: 2em;
}

entry {
    placeholder:        "Search applications...";
    placeholder-color:  @fg3;
    font: "Inter 13";
    text-color: @fg0;
}

message {
    margin:             12px 0 0;
    border-radius:      20px;
    border:             2px;
    border-color:       @border-light;
    background-color:   @bg2;
}

textbox {
    padding:    14px 24px;
    text-color: @fg0;
}

listview {
    background-color:   transparent;

    margin:             8px 0 0;
    lines:              6;
    columns:            1;

    fixed-height:       false;
    spacing:            4px;
}

element {
    padding:        10px 16px;
    spacing:        12px;
    border-radius:  18px;
    border:         2px;
    border-color:   transparent;

    background-color: transparent;
    text-color: @fg0;
}

element normal active {
    text-color: @fg0;
    background-color: @bg-glass;
    border-color: @border-light;
}

element alternate active {
    text-color: @fg0;
    background-color: @bg-glass;
    border-color: @border-light;
}

element selected normal {
    background-color:   @bg3;
    border-color:       @border-accent;
    text-color:         @fg1;
}

element selected active {
    background-color:   @bg3;
    border-color:       @border-accent;
    text-color:         @fg1;
}

element-icon {
    size:           1.2em;
    vertical-align: 0.5;
}

element-text {
    text-color: inherit;
    vertical-align: 0.5;
}

element selected element-text {
    text-color: @fg1;
    font: "Inter 13";
}

scrollbar {
    width:        6px;
    border:       0;
    handle-color: @border-accent;
    handle-width: 6px;
    padding:      4px;
    margin:       0 4px 0 0;
    background-color: @bg-glass;
    border-radius: 3px;
}
