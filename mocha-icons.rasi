* {
    /* Catppuccin Mocha - Refined Opaque & Transparent Aesthetic */
    
    /* Primary backgrounds - optimized opacity balance */
    bg0:    rgba(30, 30, 46, 0.95);       /* Main window - near opaque */
    bg1:    rgba(49, 50, 68, 0.90);       /* Secondary surfaces - mostly opaque */
    bg2:    rgba(69, 71, 90, 0.85);       /* Tertiary surfaces - balanced */
    bg3:    rgba(137, 180, 250, 0.95);    /* Accent/Selected - strong visibility */
    bg-glass: rgba(49, 50, 68, 0.40);     /* Glass overlay - subtle transparency */
    
    /* Text colors - vibrant and readable */
    fg0:    #cdd6f4;                      /* Primary text */
    fg1:    #f5e0dc;                      /* Highlight text */
    fg2:    #bac2de;                      /* Secondary text */
    fg3:    #6c7086;                      /* Tertiary text */

    /* Border styling - refined glass morphism */
    border-light: rgba(205, 214, 244, 0.25);
    border-accent: rgba(137, 180, 250, 0.70);
    border-dark: rgba(30, 30, 46, 0.50);
}

* {
    font:   "Inter 13";

    background-color:   transparent;
    text-color:         @fg0;

    margin:     0px;
    padding:    0px;
    spacing:    0px;
}

window {
    location:       north;
    y-offset:       calc(50% - 180px);
    width:          680;
    border-radius:  28px;
    border:         2px;
    border-color:   @border-accent;

    background-color:   @bg0;
    
    /* Subtle shadow effect for depth */
    shadow:         "0 8px 32px rgba(0, 0, 0, 0.40)";
}

mainbox {
    padding:    20px;
    spacing:    12px;
}

inputbar {
    background-color:   @bg1;
    border-color:       @border-accent;

    border:         2px;
    border-radius:  24px;

    padding:    14px 24px;
    spacing:    12px;
    children:   [ prompt, entry ];
}

prompt {
    text-color: @fg1;
    font: "Inter 13";
    width: 2em;
}

entry {
    placeholder:        "Search applications...";
    placeholder-color:  @fg3;
    font: "Inter 13";
    text-color: @fg0;
}

message {
    margin:             12px 0 0;
    border-radius:      20px;
    border:             2px;
    border-color:       @border-light;
    background-color:   @bg2;
}

textbox {
    padding:    14px 24px;
    text-color: @fg0;
}

listview {
    background-color:   transparent;

    margin:     8px 0 0;
    lines:      6;
    columns:    1;

    fixed-height: false;
    spacing:    4px;
}

element {
    padding:        10px 16px;
    spacing:        12px;
    border-radius:  18px;
    border:         2px;
    border-color:   transparent;

    background-color: transparent;
    text-color: @fg0;
}

element normal active {
    text-color: @fg0;
    background-color: @bg-glass;
}

element alternate active {
    text-color: @fg0;
    background-color: @bg-glass;
}

element selected normal {
    background-color:   @bg3;
    border-color:       @border-accent;
    text-color:         @bg0;
}

element selected active {
    background-color:   @bg3;
    border-color:       @border-accent;
    text-color:         @bg0;
}

element-icon {
    size:           1.2em;
    vertical-align: 0.5;
}

element-text {
    text-color: inherit;
    vertical-align: 0.5;
}

element selected element-text {
    text-color: @bg0;
    font: "Inter 13";
}

scrollbar {
    width:        6px;
    border:       0;
    handle-color: @border-accent;
    handle-width: 6px;
    padding:      4px;
    margin:       0 4px 0 0;
    background-color: @bg-glass;
    border-radius: 3px;
}
